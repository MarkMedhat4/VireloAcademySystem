# ─────────────────────────────────────────────────────────────
# Virelo Academy System — environment variables (placeholders only)
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local. NEVER put real secrets in this file.
# ─────────────────────────────────────────────────────────────

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon / publishable key (safe for the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Supabase service-role key — SERVER ONLY. Bypasses RLS.
# Never prefix with NEXT_PUBLIC_, never import it in client components.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public site URL (used for metadata). Example: https://virelo-academy.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
